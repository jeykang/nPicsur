{
  "name": "picsur-backend",
  "version": "0.7.2",
  "description": "Backend for Picsur",
  "license": "AGPL-3.0-only",
  "repository": "https://github.com/jeykang/nPicsur",
  "author": "Caramel <picsur@caramelfur.dev>",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "pnpm clean && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --max-semi-space-size=16 --expose-gc dist/main",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck:test": "tsc -p test/tsconfig.json",
    "migrate": "pnpm build && PICSUR_PRODUCTION=\"true\" typeorm migration:generate -d ./dist/datasource.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "purge": "rm -rf dist && rm -rf node_modules"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/reply-from": "^12.8.0",
    "@fastify/static": "^10.1.7",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-fastify": "^12.3.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "bcrypt-ts": "^9.0.2",
    "fastify": "^5.12.7",
    "file-type": "^21.3.4",
    "ms": "2.1.3",
    "node-addon-api": "^8.9.2",
    "openid-client": "^6.8.8",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "passport-strategy": "^1.0.0",
    "pg": "^8.23.1",
    "picsur-shared": "workspace:^",
    "posix.js": "^0.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "semver": "^7.8.5",
    "sharp": "^0.35.5",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.3.2",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.19.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/passport-strategy": "^0.2.38",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "oidc-provider": "^9.13.0",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "typescript": "~5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
