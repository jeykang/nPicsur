{
  "name": "picsur-backend",
  "version": "0.6.0",
  "description": "Backend for Picsur",
  "license": "AGPL-3.0-only",
  "repository": "https://github.com/caramelfur/Picsur",
  "author": "Caramel <picsur@caramelfur.dev>",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "pnpm clean && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck:test": "tsc -p test/tsconfig.json",
    "typeorm": "typeorm-ts-node-esm",
    "migrate": "PICSUR_PRODUCTION=\"true\" pnpm typeorm migration:generate -d ./src/datasource.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "purge": "rm -rf dist && rm -rf node_modules"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/reply-from": "^12.6.5",
    "@fastify/static": "^10.1.4",
    "@nestjs/common": "^11.2.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.2.6",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "bcrypt-ts": "^9.0.2",
    "fastify": "^5.12.5",
    "file-type": "^21.3.4",
    "ms": "2.1.3",
    "node-addon-api": "^8.9.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "passport-strategy": "^1.0.0",
    "pg": "^8.23.0",
    "picsur-shared": "workspace:^",
    "posix.js": "^0.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "semver": "^7.8.5",
    "sharp": "^0.35.4",
    "typeorm": "^0.3.31",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.6",
    "@types/ms": "^0.7.34",
    "@types/node": "^24.13.6",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/passport-strategy": "^0.2.38",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
