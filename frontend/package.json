{
  "name": "picsur-frontend",
  "version": "0.6.0",
  "description": "Frontend for Picsur",
  "license": "AGPL-3.0-only",
  "repository": "https://github.com/caramelfur/Picsur",
  "author": "Caramel <picsur@caramelfur.dev>",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "pnpm branding && ng serve --host 0.0.0.0",
    "build": "pnpm clean && pnpm branding && ng build",
    "watch": "pnpm branding && ng build --watch --configuration development",
    "branding": "rm -rf src/assets/branding && cp -r ../branding src/assets/branding",
    "clean": "rm -rf dist && rm -rf .angular",
    "purge": "pnpm clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@angular/animations": "^22.2.0",
    "@angular/build": "^22.2.0",
    "@angular/cdk": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/roboto": "^5.1.0",
    "@leteu/jwt-decoder": "^1.0.4",
    "@ng-web-apis/common": "^5.3.0",
    "@ngx-dropzone/cdk": "^22.1.0",
    "@popperjs/core": "^2.11.8",
    "@types/ackee-tracker": "^5.0.4",
    "@types/node": "^24.13.6",
    "@types/resize-observer-browser": "^0.1.11",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.12.2",
    "ackee-tracker": "^5.1.0",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.3",
    "browserslist": "^4.29.1",
    "caniuse-lite": "^1.0.30001675",
    "fuse.js": "^7.0.0",
    "material-icons": "^1.13.12",
    "moment": "^2.30.1",
    "ngx-auto-unsubscribe-decorator": "^1.1.0",
    "ngx-moment": "^6.0.2",
    "picsur-shared": "workspace:^",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.0",
    "typescript": "~6.0.3",
    "uuid": "^11.1.1",
    "zod": "^3.25.76",
    "zone.js": "~0.15.1"
  }
}
