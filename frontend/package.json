{
  "name": "picsur-frontend",
  "version": "0.7.1",
  "description": "Frontend for Picsur",
  "license": "AGPL-3.0-only",
  "repository": "https://github.com/jeykang/nPicsur",
  "author": "Caramel <picsur@caramelfur.dev>",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "pnpm branding && ng serve --host 0.0.0.0",
    "build": "pnpm clean && pnpm branding && ng build",
    "watch": "pnpm branding && ng build --watch --configuration development",
    "branding": "rm -rf src/assets/branding && cp -r ../branding src/assets/branding",
    "clean": "rm -rf dist && rm -rf .angular",
    "purge": "pnpm clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/build": "^22.2.5",
    "@angular/cdk": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@fontsource/roboto": "^5.3.0",
    "@ng-web-apis/common": "^5.4.0",
    "@ngx-dropzone/cdk": "^22.1.0",
    "@popperjs/core": "^2.11.8",
    "@types/ackee-tracker": "^5.0.4",
    "@types/node": "^24.19.2",
    "@types/resize-observer-browser": "^0.1.11",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.15.10",
    "ackee-tracker": "^5.1.3",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "browserslist": "^4.29.4",
    "caniuse-lite": "^1.0.30001819",
    "fuse.js": "^7.5.0",
    "material-icons": "^1.13.14",
    "moment": "^2.31.0",
    "ngx-auto-unsubscribe-decorator": "^1.1.0",
    "ngx-moment": "^6.0.2",
    "picsur-shared": "workspace:^",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "uuid": "^11.1.1",
    "zod": "^4.6.7",
    "zone.js": "~0.16.3"
  }
}
